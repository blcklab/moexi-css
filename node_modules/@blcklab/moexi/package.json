{
  "name": "@blcklab/moexi",
  "version": "1.1.1",
  "description": "A lightweight, framework-agnostic premium kawaii, chibi-inspired icon ecosystem for the web.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,

  "repository": {
    "type": "git",
    "url": "https://github.com/blcklab/moexi"
  },
  "bugs": {
    "url": "https://github.com/blcklab/moexi/issues"
  },
  "homepage": "https://github.com/blcklab/moexi#readme",

  "files": [
    "dist/esm",
    "dist/cjs",
    "dist/types",
    "dist/catalog/api-surface.json",
    "dist/catalog/manifest.json",
    "dist/catalog/icons.json",
    "dist/catalog/search-index.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./icons/*": {
      "types": "./dist/types/icons/*.d.ts",
      "import": "./dist/esm/icons/*.js",
      "require": "./dist/cjs/icons/*.js"
    },
    "./categories/*": {
      "types": "./dist/types/categories/*.d.ts",
      "import": "./dist/esm/categories/*.js",
      "require": "./dist/cjs/categories/*.js"
    },
    "./package.json": "./package.json",
    "./authoring": {
      "types": "./dist/types/authoring/index.d.ts",
      "import": "./dist/esm/authoring/index.js",
      "require": "./dist/cjs/authoring/index.js"
    },
    "./collection": {
      "types": "./dist/types/collection.d.ts",
      "import": "./dist/esm/collection.js",
      "require": "./dist/cjs/collection.js"
    },
    "./catalog/icons.json": "./dist/catalog/icons.json",
    "./catalog/search-index.json": "./dist/catalog/search-index.json",
    "./catalog/manifest.json": "./dist/catalog/manifest.json",
    "./catalog/api-surface.json": "./dist/catalog/api-surface.json"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ./scripts/finalize-build.mjs && node ./scripts/generate-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm test && npm run check:budgets && npm run check:package && npm run check:release",
    "artifacts": "node ./scripts/generate-artifacts.mjs",
    "check:budgets": "node ./scripts/check-budgets.mjs",
    "check:package": "node ./scripts/check-package.mjs",
    "check:release": "node ./scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "icons",
    "svg",
    "vanilla",
    "framework-agnostic",
    "typescript",
    "ui",
    "icon-pack",
    "kawaii",
    "cute",
    "aesthetic"
  ],
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}