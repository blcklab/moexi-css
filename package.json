{
  "name": "@blcklab/moexi-css",
  "version": "1.0.0",
  "description": "CSS-class adapter for Moexi icons: use premium kawaii SVG icons with classes like mx mx-search.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "style": "./dist/moexi.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/moexi.css",
    "./moexi.css": "./dist/moexi.css",
    "./regular.css": "./dist/regular.css",
    "./base.css": "./dist/base.css",
    "./icons/*.css": "./dist/icons/*.css",
    "./categories/*.css": "./dist/categories/*.css",
    "./svg/*": "./dist/svg/*",
    "./catalog.json": "./dist/catalog.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "generate": "node ./scripts/generate.mjs",
    "build": "npm run clean && npm run generate",
    "test": "npm run build && node --test",
    "check:budgets": "node ./scripts/check-budgets.mjs",
    "check:package": "node ./scripts/check-package.mjs",
    "check:release": "node ./scripts/verify-release.mjs",
    "check": "npm test && npm run check:budgets && npm run check:package && npm run check:release"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "icons",
    "css",
    "svg",
    "mask",
    "kawaii",
    "moexi",
    "icon-pack",
    "bootstrap-icons-alternative"
  ],
  "devDependencies": {
    "@blcklab/moexi": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blcklab/moexi-css"
  },
  "bugs": {
    "url": "https://github.com/blcklab/moexi-css/issues"
  },
  "homepage": "https://github.com/blcklab/moexi-css#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
